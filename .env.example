# ==============================================================================
# Concerned Citizens of PE Metro - Environment Variables
# Nelson Mandela Bay Metropolitan Task Team Community Portal
# ==============================================================================

# Supabase Cloud Database Configuration (Frontend & Client SDK)
# Get these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Server-Side Configuration (Optional, if using server-side queries)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook Graph API Configuration (For syncing official Facebook page posts)
# Get these from Meta for Developers (https://developers.facebook.com)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Gemini AI API Configuration (Server-Side Only)
GEMINI_API_KEY=

# Server & App URL
PORT=3000
APP_URL=
